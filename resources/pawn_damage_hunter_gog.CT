<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries>
    <CheatEntry>
      <ID>100</ID>
      <Description>"[1] GOG ПРОВЕРКА: Игрок + Пешки + Инклинации"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(pBaseSig, DDDA.exe, 8B 15 ?? ?? ?? ?? 33 DB 8B F8)
registersymbol(pBaseSig)

{$lua}
if syntaxcheck then return end
local sig = getAddress('pBaseSig')
if not sig or sig == 0 then print('pBaseSig не найден!') return end
local pBase = readPointer(readInteger(sig + 2))
if not pBase or pBase == 0 then print('pBase = 0 (игра загружена?)') return end

local vocations = {
  [1]='Fighter', [2]='Strider', [3]='Mage', [4]='Mystic Knight', [5]='Assassin',
  [6]='Magick Archer', [7]='Warrior', [8]='Ranger', [9]='Sorcerer'
}
local incNames = {'Scather','Medicant','Mitigator','Challenger','Utilitarian','Guardian','Nexus','Pioneer','Acquisitor'}

local player   = pBase + 0xA7000
local mainPawn = player + 0x7F0
local pawn1    = mainPawn + 0x1660
local pawn2    = pawn1 + 0x1660

print("=================================================================")
print("  DDDA AI Overhaul — GOG База Данных Персонажей")
print("=================================================================")
print(string.format("pBase:         0x%X", pBase))
print(string.format("Игрок:         0x%X", player))
print(string.format("Главная пешка: 0x%X", mainPawn))
print(string.format("Наемник 1:     0x%X", pawn1))
print(string.format("Наемник 2:     0x%X", pawn2))

-- Вывод инклинаций главной пешки
print("\n--- Инклинации Главной Пешки ---")
local inclBase = mainPawn + 0x96C + 0x1224
for i = 1, 9 do
  local val = readFloat(inclBase + (i-1) * 0xC)
  print(string.format("  %-12s: %.1f", incNames[i], val or 0.0))
end

-- Проверка известных врагов mStudyFlag
local studyBase = mainPawn + 0x1616
local knownCount = 0
for i = 0, 321 do
  local b = readBytes(studyBase + i, 1)
  if b and b ~= 0 then knownCount = knownCount + 1 end
end
print(string.format("\nЗнания бестиария (mStudyFlag): %d / 322 байт заполнено", knownCount))
print("=================================================================")
{$asm}

[DISABLE]
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>200</ID>
      <Description>"[2] ДИСПЕТЧЕР УРОНА: Перехват любого удара по врагу (Breakpoint Hook)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// Хук на известную точку вызова урона игрока (CI1)
aobscanmodule(dmgCallSig, DDDA.exe, 51 F3 0F 11 0C 24 E8 ?? ?? ?? ?? 8B ?? 8B ?? D4 01 00 00)
registersymbol(dmgCallSig)

{$lua}
if syntaxcheck then return end
local addr = getAddress('dmgCallSig')
if not addr or addr == 0 then
  print("dmgCallSig не найден. Попробуем ручной поиск...")
  return
end

local callSite = addr + 6
local rel = readInteger(callSite + 1)
local targetFunc = callSite + 5 + rel

print("=================================================================")
print("  ТОЧКИ УРОНА В DDDA.exe (GOG)")
print("=================================================================")
print(string.format("Инструкция вызова урона (CI1): 0x%X", callSite))
print(string.format("Корневая функция урона (TakeDamage): 0x%X", targetFunc))
print("=================================================================")
{$asm}

[DISABLE]
</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
</CheatTable>
